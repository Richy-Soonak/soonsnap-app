# ─── Supabase ──────────────────────────────────────────────────────────────
# Supabase project URL
SUPABASE_URL=
# Supabase anonymous key (public)
SUPABASE_ANON_KEY=

# ─── Solana ────────────────────────────────────────────────────────────────
# Solana RPC endpoint (mainnet-beta or devnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# $SOONAK token mint address
SOONAK_MINT=H218TQViAXsSqwCLnf7L41zewUTRmdN1r4neLtjBXYXS

# ─── Stripe ────────────────────────────────────────────────────────────────
# Stripe secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# ─── NVIDIA AI ─────────────────────────────────────────────────────────────
# NVIDIA API key for AI enhancement pipeline
NVIDIA_API_KEY=

# ─── Redis / BullMQ ───────────────────────────────────────────────────────
# Redis connection URL for job queue
REDIS_URL=redis://localhost:6379

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────
# R2 access key ID
R2_ACCESS_KEY=
# R2 secret access key
R2_SECRET_KEY=
# R2 bucket name
R2_BUCKET=
# R2 endpoint URL
R2_ENDPOINT=

# ─── Auth ──────────────────────────────────────────────────────────────────
# JWT secret for signing auth tokens
JWT_SECRET=
